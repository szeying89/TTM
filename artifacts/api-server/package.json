{
  "name": "@intel-threat-modeller/api-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "exports": {
    ".": "./dist/server.js",
    "./db/client": "./dist/db/client.js",
    "./db/schema": "./dist/db/schema/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "db:generate": "pnpm run build && drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "smoke-e2e": "tsx src/e2e/smoke-e2e.ts"
  },
  "dependencies": {
    "@intel-threat-modeller/contracts": "workspace:*",
    "@intel-threat-modeller/llm-client": "workspace:*",
    "@intel-threat-modeller/embeddings": "workspace:*",
    "fastify": "^5.1.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/cors": "^11.0.0",
    "drizzle-orm": "^0.36.0",
    "pg": "^8.13.0",
    "zod": "^3.24.0",
    "jsdom": "^25.0.0",
    "@mozilla/readability": "^0.6.0",
    "unpdf": "^1.8.0",
    "playwright": "^1.48.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0",
    "@types/jsdom": "^21.1.0",
    "drizzle-kit": "^0.28.0",
    "msw": "^2.6.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
