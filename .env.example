# Postgres (with pgvector extension)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/intel_threat_modeller

# LLM provider (default: Anthropic)
ANTHROPIC_API_KEY=
LLM_DEFAULT_MODEL=claude-opus-5
LLM_FAST_MODEL=claude-sonnet-5

# Embedding provider (default: Voyage AI)
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-3-large

# api-server
API_PORT=4000

# Gate live-API smoke tests (unset/0 = skip, only mocked tests run)
RUN_LIVE_API_TESTS=0
